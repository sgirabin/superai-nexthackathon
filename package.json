{
  "name": "agentic-goaround-sg",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic GoAround SG hackathon MVP monorepo",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@goaround/web run dev",
    "build": "npm --workspace=@goaround/agent-core run build && npm --workspace=@goaround/web run build",
    "lint": "npm --workspace=@goaround/web run lint",
    "typecheck": "npm --workspaces run typecheck",
    "test": "npm --workspaces run test"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
