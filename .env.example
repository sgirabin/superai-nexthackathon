# Exa live search integration
EXA_API_KEY=
EXA_API_BASE_URL=https://api.exa.ai

# Vercel AI Gateway integration
# Configure in Vercel project environment or local .env.local.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Stripe integration, later phase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App config
NEXT_PUBLIC_APP_NAME=GoAround SG
NEXT_PUBLIC_AGENT_API_MODE=local
NEXT_PUBLIC_DEFAULT_LOCATION=Sengkang
NEXT_PUBLIC_DEFAULT_RADIUS_KM=1.5
